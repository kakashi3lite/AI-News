# Database Configuration
# For development, you can use SQLite: file:./dev.db
# For production, use PostgreSQL: postgresql://username:password@localhost:5432/ai_news_db
DATABASE_URL="file:./dev.db"

# Authentication
# Generate a secret key: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Required API Keys
# OpenAI API key for AI features (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# News API key for content aggregation (get from https://newsapi.org/)
NEWS_API_KEY="your-news-api-key-here"

# Google API key for additional features (get from https://console.cloud.google.com/)
GOOGLE_API_KEY="your-google-api-key-here"

# YouTube Data API key for video processing (get from https://console.cloud.google.com/)
YOUTUBE_API_KEY="your-youtube-api-key-here"

# Optional Analytics Services
# Vercel Analytics (get from https://vercel.com/analytics)
VERCEL_ANALYTICS_ID="your-vercel-analytics-id"

# Mixpanel for user behavior tracking (get from https://mixpanel.com/)
MIXPANEL_TOKEN="your-mixpanel-token"

# PostHog for product analytics (get from https://posthog.com/)
POSTHOG_KEY="your-posthog-key"
POSTHOG_HOST="https://app.posthog.com"

# Sentry for error tracking (get from https://sentry.io/)
SENTRY_DSN="your-sentry-dsn"

# Feature Flags (true/false)
ENABLE_VOICE_SEARCH="true"
ENABLE_REAL_TIME_COLLAB="false"
ENABLE_ADVANCED_AI="true"
ENABLE_SOCIAL_FEATURES="true"
ENABLE_EXPERIMENTATION="true"
ENABLE_CONTEXT_AWARENESS="true"
ENABLE_ANALYTICS="true"

# Redis Configuration (for caching and real-time features)
# For development, you can use local Redis or skip this
REDIS_URL="redis://localhost:6379"

# Email Configuration (for notifications)
# SMTP settings for sending emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="AI News Dashboard <noreply@ai-news-dashboard.com>"

# Social Authentication (Optional)
# GitHub OAuth (get from https://github.com/settings/developers)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Twitter OAuth (get from https://developer.twitter.com/)
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"

# Environment Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Performance and Monitoring
# Enable performance monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING="true"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# Security
# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,https://your-domain.com"

# Content Security Policy
CSP_ENABLED="true"

# Webhook URLs (for integrations)
SLACK_WEBHOOK_URL="your-slack-webhook-url"
DISCORD_WEBHOOK_URL="your-discord-webhook-url"

# AI Model Configuration
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_MAX_TOKENS="4000"
OPENAI_TEMPERATURE="0.7"

# Search Configuration
SEARCH_RESULTS_LIMIT="50"
SEARCH_CACHE_TTL="300"

# Social Features
MAX_COMMENT_LENGTH="500"
MAX_SHARE_DESCRIPTION_LENGTH="280"

# File Upload (if needed)
MAX_FILE_SIZE="5242880"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webp"

# Logging
LOG_LEVEL="info"
LOG_FORMAT="json"

# Development Tools
# Enable debug mode for development
DEBUG="true"

# Storybook configuration
STORYBOOK_PORT="6006"

# Testing
TEST_DATABASE_URL="file:./test.db"

# Backup and Recovery
BACKUP_ENABLED="false"
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS="30"
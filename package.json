{
  "name": "ai-news-dashboard",
  "version": "1.0.0",
  "description": "Context-Aware AI News Dashboard with Arc-style search and social features",
  "private": true,
  "author": "Dr. Phoenix SoloSprint Vega",
  "license": "MIT",
  "keywords": [
    "ai",
    "news",
    "dashboard",
    "context-aware",
    "react",
    "typescript",
    "social",
    "search"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "analyze": "cross-env ANALYZE=true next build",
    "build:analyze": "npm run analyze",
    "deploy:staging": "vercel --target staging",
    "deploy:production": "vercel --prod",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/seed.js",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "performance:lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./reports/lighthouse.html",
    "performance:bundle": "npm run build && npx bundle-analyzer",
    "setup": "npm install && npm run db:generate && npm run db:migrate",
    "clean": "rm -rf .next node_modules",
    "reinstall": "npm run clean && npm install",
    "precommit": "npm run lint && npm run type-check && npm run test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "typescript": "^5.3.3",
    "tailwindcss": "^3.3.6",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "lucide-react": "^0.294.0",
    "framer-motion": "^10.16.16",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "tailwind-merge": "^2.2.0",
    "@prisma/client": "^5.7.1",
    "prisma": "^5.7.1",
    "next-auth": "^4.24.5",
    "@next-auth/prisma-adapter": "^1.0.7",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "react-hook-form": "^7.48.2",
    "@hookform/resolvers": "^3.3.2",
    "axios": "^1.6.2",
    "swr": "^2.2.4",
    "zustand": "^4.4.7",
    "immer": "^10.0.3",
    "date-fns": "^2.30.0",
    "react-intersection-observer": "^9.5.3",
    "react-virtualized-auto-sizer": "^1.0.20",
    "react-window": "^1.8.8",
    "fuse.js": "^7.0.0",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "react-hotkeys-hook": "^4.4.1",
    "react-speech-recognition": "^3.10.0",
    "regenerator-runtime": "^0.14.0",
    "socket.io-client": "^4.7.4",
    "@vercel/analytics": "^1.1.1",
    "@vercel/speed-insights": "^1.0.2",
    "sharp": "^0.33.1",
    "next-sitemap": "^4.2.3",
    "next-seo": "^6.4.0",
    "react-error-boundary": "^4.0.11",
    "@sentry/nextjs": "^7.85.0",
    "mixpanel-browser": "^2.47.0",
    "posthog-js": "^1.96.1",
    "react-hot-toast": "^2.4.1",
    "react-loading-skeleton": "^3.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "rehype-highlight": "^7.0.0",
    "highlight.js": "^11.9.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-badge": "^1.0.4",
    "react-use-gesture": "^9.1.3",
    "use-sound": "^4.0.1",
    "workbox-webpack-plugin": "^7.0.0",
    "next-pwa": "^5.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/react-window": "^1.8.8",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "prettier": "^3.1.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.6",
    "@testing-library/user-event": "^14.5.1",
    "jest-environment-jsdom": "^29.7.0",
    "cypress": "^13.6.2",
    "@cypress/code-coverage": "^3.12.18",
    "cross-env": "^7.0.3",
    "@next/bundle-analyzer": "^14.0.4",
    "lighthouse": "^11.4.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "dotenv": "^16.3.1",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5",
    "msw": "^2.0.11",
    "@faker-js/faker": "^8.3.1",
    "@storybook/react": "^7.6.6",
    "@storybook/addon-essentials": "^7.6.6",
    "@storybook/addon-interactions": "^7.6.6",
    "@storybook/addon-links": "^7.6.6",
    "@storybook/blocks": "^7.6.6",
    "@storybook/nextjs": "^7.6.6",
    "@storybook/testing-library": "^0.2.2",
    "storybook": "^7.6.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@/components/(.*)$": "<rootDir>/components/$1",
      "^@/contexts/(.*)$": "<rootDir>/contexts/$1",
      "^@/utils/(.*)$": "<rootDir>/utils/$1",
      "^@/api/(.*)$": "<rootDir>/api/$1"
    },
    "collectCoverageFrom": [
      "components/**/*.{js,jsx,ts,tsx}",
      "contexts/**/*.{js,jsx,ts,tsx}",
      "utils/**/*.{js,jsx,ts,tsx}",
      "api/**/*.{js,jsx,ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/username/ai-news-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/username/ai-news-dashboard/issues"
  },
  "homepage": "https://ai-news-dashboard.com"
}
